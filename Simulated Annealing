import random
import math

def f(x):
    return eval(expression)

expression = input("Enter function in x (e.g. -(x-5)**2 + 25): ")
x = int(input("Enter starting value: "))
low = int(input("Enter lower limit: "))
high = int(input("Enter upper limit: "))
T = float(input("Enter initial temperature: "))

while T > 0.1:
    new_x = x + random.choice([-1, 1])

    if low <= new_x <= high:
        delta = f(new_x) - f(x)

        if delta > 0 or random.random() < math.exp(delta / T):
            x = new_x

    T *= 0.95

print("Best solution:", x)
print("Maximum value:", f(x))
