import random
import math

def f(x):
    return -(x - 5) ** 2 + 25

x = random.randint(0, 10)
T = 100

while T > 0.1:
    new_x = x + random.choice([-1, 1])

    if 0 <= new_x <= 10:
        delta = f(new_x) - f(x)

        if delta > 0 or random.random() < math.exp(delta / T):
            x = new_x

    T *= 0.95

print("Best solution:", x)
print("Maximum value:", f(x))
