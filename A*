import heapq

def heuristic(state, goal):
    distance = 0

    for i in range(9):
        tile = state[i]

        if tile != 0:
            current_row, current_col = divmod(i, 3)
            goal_pos = goal.index(tile)
            goal_row, goal_col = divmod(goal_pos, 3)

            distance += abs(current_row - goal_row) + abs(current_col - goal_col)

    return distance

def astar(start, goal):
    pq = [(heuristic(start, goal), 0, start)]
    parent = {start: None}
    cost = {start: 0}

    while pq:
        _, g, state = heapq.heappop(pq)

        if g != cost[state]:
            continue

        if state == goal:
            path = []
            while state is not None:
                path.append(state)
                state = parent[state]
            return path[::-1]

        blank = state.index(0)
        row, col = divmod(blank, 3)

        moves = []
        if row > 0:
            moves.append(blank - 3)
        if row < 2:
            moves.append(blank + 3)
        if col > 0:
            moves.append(blank - 1)
        if col < 2:
            moves.append(blank + 1)

        for move in moves:
            new_state = list(state)
            new_state[blank], new_state[move] = new_state[move], new_state[blank]
            new_state = tuple(new_state)
            new_g = g + 1

            if new_g < cost.get(new_state, float("inf")):
                cost[new_state] = new_g
                parent[new_state] = state
                heapq.heappush(
                    pq, (new_g + heuristic(new_state, goal), new_g, new_state)
                )

    return None

def display(state):
    for i in range(0, 9, 3):
        print(state[i:i + 3])
    print()

start = (2, 8, 3, 1, 6, 4, 0, 7, 5)
goal = (1, 2, 3, 8, 0, 4, 7, 6, 5)

path = astar(start, goal)

if path:
    print("Solution found in", len(path) - 1, "moves")
    for state in path:
        display(state)
else:
    print("No solution found")
